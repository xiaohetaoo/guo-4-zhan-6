<?xml version="1.0" encoding="utf-8"?>
<!--
  界面文案统一放在这里。

  历史情况：strings.xml 里只有 app_name 一条，其余 31 处按钮 / 对话框文案都直接写在
  Composable 的 Text("…") 里。单语言（中文）下能跑，但无法本地化，
  也让「同一句文案在多处出现」变得难以统一维护。
  这里把 UI 层的 Text 字面量全部资源化；数据层（成就名、段位名等）属于领域数据，
  不是界面文案，仍保留在 Kotlin 常量中。
-->
<resources>
    <string name="app_name">过四斩六</string>

    <!-- 通用动作 -->
    <string name="action_back">返回</string>
    <string name="action_close">关闭</string>
    <string name="action_speak">朗读</string>
    <string name="action_cancel">取消</string>
    <string name="action_ok">确定</string>
    <string name="action_done">完成</string>
    <string name="action_quit">退出</string>
    <string name="action_copy_path">复制路径</string>

    <!-- 通用状态 -->
    <string name="state_loading">加载中…</string>
    <string name="title_settings">设置</string>
    <string name="title_operation_failed">操作失败</string>

    <!-- 词库 -->
    <string name="action_browse_all">浏览全部</string>
    <string name="hint_search">搜索单词或中文释义</string>

    <!-- 学习 -->
    <!-- 与 AppViewModel 入口点击时的提示同一句：原先这里写「这个队列没有单词」，
         同一件事两种说法，而且「队列」是实现术语，用户看不到队列。 -->
    <string name="study_empty_queue">这里暂时没有需要学习的单词</string>
    <string name="study_reveal">查看释义与例句</string>
    <string name="study_unknown">不认识</string>
    <!-- 「认识了」改「认识」：与统计位、结算项、等级 2 的标签同一说法，
         也避免「认识了」读起来像过去式旁白。 -->
    <string name="study_known">认识</string>

    <!-- 闯关 -->
    <string name="quiz_quit_title">退出本次闯关？</string>
    <string name="practice_quit_title">退出本次练习？</string>
    <!-- 拓展练习从「我的」页进来，这个按钮落到的就是「我的」页（见 AppRoot 的 onOpenProfile）。
         原写「返回拓展练习」读起来像回到练习题目列表，容易让人以为还能续上同一局。 -->
    <string name="action_back_practice">返回「我的」</string>
    <string name="quiz_quit_message">本局进度与成绩不会保存。</string>
    <string name="action_continue_quiz">继续答题</string>
    <string name="action_start_challenge">开始挑战</string>
    <string name="action_start_practice">开始练习</string>
    <string name="quiz_lexicon_not_ready">词库尚未就绪</string>
    <string name="quiz_topic_confusable">易混词辨析</string>
    <!-- 题数用 %1$d 占位，由调用方传 UNIT_QUIZ_COUNT：
         写死「10 题」时改题数会漏改这一行，而闯关页的其它题数文案已经是常量插值了。
         分隔一律用顿号：界面文案已统一去掉间隔号「·」，这三行是最后剩下的三处。 -->
    <string name="quiz_topic_confusable_desc">给中文释义，从四个形近词中挑出正确单词、%1$d题</string>
    <string name="quiz_topic_translation">真题句子翻译</string>
    <string name="quiz_topic_translation_desc">给出中文句子，选出全部正确译法，可多选、%1$d题</string>
    <!-- 拓展资源练习：入口在「我的」页成就卡下方，成绩不参与排行榜排名 -->
    <string name="profile_extension_title">拓展资源练习</string>
    <string name="profile_extension_note">专项巩固，随时可练、不计入排行榜排名</string>
    <string name="hint_input_word">输入英文单词</string>
    <string name="action_play_again">再来一局</string>
    <string name="action_view_leaderboard">查看排行榜</string>
    <string name="leaderboard_entry_desc">查看每一次闯关的得分与排名</string>

    <!-- 设置 / 数据管理 -->
    <string name="reset_confirm_title">确认清空全部数据？</string>
    <!-- 列举必须和 VocabRepository.resetAll() 的真实删除范围一致：
         它走 prefs.edit().clear()，界面动效开关同样会被清掉，之前漏了这一项。 -->
    <string name="reset_confirm_message">学习进度、闯关成绩、成就记录与应用设置（级别、每日目标、语速、界面动效、图标与明暗模式）都会被删除，且无法恢复。</string>
    <string name="action_reset_confirm">确认清空</string>
    <string name="restore_pick_title">选择要恢复的备份</string>
    <string name="restore_confirm_title">确认恢复数据？</string>
    <string name="action_restore_confirm">确认恢复</string>
    <string name="restore_wordbook_title">这份备份来自另一版词库</string>
    <string name="restore_wordbook_keep">仍要恢复</string>

    <!-- 无障碍描述：自绘图标本身没有语义，需要由承载它的容器提供朗读文本 -->
    <string name="cd_fav_add">加入生词本</string>
    <string name="cd_fav_remove">从生词本移除</string>
    <!-- 熟练度圆点的无障碍描述，%1$d 为已点亮数量，%2$d 为总数 -->
    <!-- 量表本身改名「熟练度」：0 未学到 5 精通六档里「掌握」是第 4 档，
         再叫「掌握等级 3/5」就等于用第 4 档的名字命名整把尺子。 -->
    <string name="cd_level_dots">熟练度 %1$d/%2$d</string>
</resources>
